# 复制为 .env 并填写实际值，.env 不要提交到版本库
# DB
DB_SERVER=127.0.0.1
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# 加密密钥（需与现有数据兼容，更换需重新加密）
# 部署时务必替换为你的实际密钥！
SECRIT_KEY=change_me_to_a_random_32_char_key
SIV=change_me_16_chars
SIV_JEC=change_me_to_32_random_chars_here

# 管理员密钥
ADMIN_KEY=your_strong_admin_password

# 防入侵：管理员入口密钥，设置后访问后台必须用 /private/login.php?key=你的密钥
ADMIN_PATH=your_random_secret_key_here

# 防入侵：管理员 IP 白名单（可选，逗号分隔，留空不限制）
# ADMIN_IP_WHITELIST=192.168.1.100,203.0.113.50

# WebSocket 连接密钥：设置后，设备/前端连接需在 URL 带 ?k=WS_SECRET
# 留空则不做连接校验（不推荐生产环境留空）
# WS_SECRET=your_random_ws_secret_here

# ======== 远程多区域操作（零延迟/防抖配置） ========
# 服务器区域标签：auto/cn/us/eu/asia（影响跨区域 ping 超时计算）
# WS_REGION=auto
# 跨区域 ping 超时放大倍数（默认 2，远程场景建议 3-4）
# WS_REGION_PING_FACTOR=2
# 屏幕帧抖动缓冲（ms），跨区域远程场景建议 80-150
# WS_SCREEN_JITTER_MS=50
# 设备自动移除保护：0=永不自动移除设备记录，仅从页面卸载时删除
# 安全阀：如果你希望极端情况自动清理，设大于 0（天数）
# WS_DEVICE_AUTO_REMOVE_DAYS=0
# WebSocket 在线超时时间（秒），跨区域远程建议 300-600
# WS_PING_TIMEOUT_SEC=300
# 不立即标记离线：连接关闭时等待超时才判定离线（默认关闭=不立即标记）
# WS_MARK_OFFLINE_ON_CLOSE=0
# 不启用 ping 探测：避免跨区域误判（默认关闭）
# WS_ENABLE_PING_PROBE=0

# ======== ADB 桥接（安卓持久连接） ========
# ADB_BRIDGE_ENABLE=1
# 固定设备列表：IP:PORT,IP:PORT
# ADB_DEVICE_LIST=192.168.1.10:5555,192.168.1.11:5555
# 局域网自动扫描
# ADB_AUTO_SCAN=1
# ADB_AUTO_SCAN_SUBNET=192.168.1.0/24
# 心跳间隔（秒）
# ADB_HEARTBEAT_INTERVAL_SEC=30
# 重连退避（秒）
# ADB_CONNECT_BACKOFF_MIN=10
# ADB_CONNECT_BACKOFF_MAX=300
# 离线通知限频（秒），同一设备离线后最多每 N 秒推送一次 device.close
# ADB_STALE_NOTIFY_INTERVAL_SEC=3600

# ======== ADB ROM 适配（国产机型权限链） ========
# 新设备连接后自动运行权限授予命令（默认启用）
# ADB_ROM_AUTOGRANT_ENABLE=1
# 设备定期扫描时重新检测 ROM 类型（默认每 6 小时）
# ADB_ROM_DETECT_INTERVAL_SEC=21600

# ======== APK 构建区域适配 ========
# 构建区域: cn（国内版）/ global（国际版）
# 影响: 通知默认语言、strings.xml、部分 smali 行为
# build_region=global

# ======== Docker 构建环境 ========
# PHP 可执行文件路径（Docker 下自动检测）
# PHP_PATH=php
# 是否在 Docker 中运行（自动检测）
# DOCKER_ENV=0
# APK 签名密钥库密码
# KEYSTORE_PASS=android123
