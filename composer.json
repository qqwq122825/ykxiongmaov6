{
    "name": "pandaworkshop/api",
    "description": "Panda Workshop - PHP API Backend",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "ext-gd": "*",
        "ext-openssl": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "phpmailer/phpmailer": "^6.9",
        "geoip2/geoip2": "^2.13",
        "robthree/twofactorauth": "^2.1",
        "php-ffmpeg/php-ffmpeg": "^1.1",
        "spatie/temporary-directory": "^2.2"
    },
    "autoload": {
        "files": [
            "private/loadEnv.php",
            "private/mock_api.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
