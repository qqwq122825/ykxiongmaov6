# Docker 部署用 - 复制到项目根目录为 .env
# ⚠️ 所有密码/密钥必须修改为强随机值！不要使用默认值！

# MySQL 容器
MYSQL_ROOT_PASSWORD=change_me_strong_root_password
MYSQL_DATABASE=zgl
MYSQL_USER=zgl
MYSQL_PASSWORD=change_me_strong_db_password

# PHP 应用（与上方保持一致）
DB_SERVER=mysql
DB_USER=zgl
DB_PASS=change_me_strong_db_password
DB_NAME=zgl

# 后台管理密码（/private/login.php 登录用）
ADMIN_KEY=change_me_strong_admin_password

# 防入侵：管理员入口密钥，设置后必须用 /private/login.php?key=xxx 访问
ADMIN_PATH=change_me_random_secret_key

# 防入侵：IP 白名单（可选，逗号分隔）
# ADMIN_IP_WHITELIST=192.168.1.1

# WebSocket 连接密钥（防未授权连接，建议设置）
# WS_SECRET=your_random_ws_secret_here
